rules_version = '2';
// Lotus Hub — Firestore security rules.
// Paste these into Firebase console → Firestore → Rules (or deploy via CLI).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    // Profiles: anyone signed in can read (to show names/ratings on rosters);
    // only the owner can write their own doc.
    // NOTE: duprId / rating fields are written server-side by Cloud Functions
    // using the Admin SDK, which bypasses these rules. Clients must not be
    // trusted to set their own rating — tighten with a field check before launch.
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if isSelf(uid);
    }

    // Sessions: readable by any signed-in user; created by any signed-in user
    // (must set themselves as organizer); only the organizer can edit/delete.
    // attendeeCount is updated by RSVP transactions, so updates are allowed for
    // signed-in users but should be locked down further before launch.
    match /sessions/{sessionId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.organizerUid == request.auth.uid;
      allow update: if signedIn();
      allow delete: if signedIn() && resource.data.organizerUid == request.auth.uid;

      // RSVPs: you can only create/edit/delete your OWN rsvp doc; anyone signed
      // in can read the roster.
      match /rsvps/{uid} {
        allow read: if signedIn();
        allow write: if isSelf(uid);
      }
    }

    // Matches are created/validated server-side (Cloud Functions) before being
    // pushed to DUPR — clients get read-only access.
    match /matches/{matchId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Shared trackers (e.g. the wedding thank-you card tracker). Open by
    // request: no sign-in, so anyone who has the app link can view/edit. Keep
    // it private by not sharing the URL. To lock it back down later, require
    // auth here (e.g. `if request.auth != null`) and restore the sign-in gate.
    match /trackers/{trackerId} {
      allow read, write: if true;
    }

    // Leaderboards — shared boards for things like the monthly Lotus
    // Challenge. Same "open by request" model as trackers above: no
    // sign-in, anyone with the link can view/edit. Keep it private by not
    // sharing the URL.
    //
    // Writes are still open to anyone (no auth — same trust model as the
    // admin PIN, which is a UI-only deterrent, not enforced here), but must
    // match the shape the app actually writes. This stops a write crafted
    // directly against the Firestore SDK (bypassing app.js and its PIN
    // prompt entirely) from corrupting the document with a runaway entries
    // array, oversized strings, a spoofed adminPinHash, or a backdated
    // updatedAt. It does NOT validate individual entries inside the array
    // (a garbage player name/DUPR value within a well-shaped doc still gets
    // through) — the Firestore rules language has no per-element loop, and
    // entries is a plain array rather than a subcollection. Real protection
    // for that would need Firebase Auth + a data model change; out of scope
    // here, same as the PIN's own documented limits (see leaderboard/README.md).
    function isValidLeaderboard(d) {
      return d.keys().hasOnly(['title', 'subtitle', 'entries', 'adminPinHash', 'updatedAt', 'updatedBy', 'updatedByEmail'])
        && d.title is string && d.title.size() <= 120
        && d.subtitle is string && d.subtitle.size() <= 120
        && d.entries is list && d.entries.size() <= 300
        && (d.adminPinHash == null || (d.adminPinHash is string && d.adminPinHash.size() == 64))
        && d.updatedAt == request.time
        && d.updatedBy is string && d.updatedBy.size() <= 128
        && (d.updatedByEmail == null || (d.updatedByEmail is string && d.updatedByEmail.size() <= 254));
    }
    match /leaderboards/{boardId} {
      allow read: if true;
      allow write: if isValidLeaderboard(request.resource.data);
    }

    // TapMenu — multi-tenant QR menu / link pages for local businesses.
    // Anyone (a customer scanning the QR) can READ a menu; only the signed-in
    // owner can create and edit their own. The doc id is the public slug used
    // in the QR URL (/menu/?m=<slug>).
    match /menus/{slug} {
      allow read: if true;
      // On create, the caller must stamp themselves as the owner.
      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid;
      // Only the current owner may edit or delete, and they cannot hand the
      // doc to someone else (ownerUid stays pinned to them).
      allow update: if signedIn()
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn()
                    && resource.data.ownerUid == request.auth.uid;
    }
  }
}
