rules_version = '2';
// Lotus Hub — Firestore security rules.
// Paste these into Firebase console → Firestore → Rules (or deploy via CLI).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    // Profiles: anyone signed in can read (to show names/ratings on rosters);
    // only the owner can write their own doc.
    // NOTE: duprId / rating fields are written server-side by Cloud Functions
    // using the Admin SDK, which bypasses these rules. Clients must not be
    // trusted to set their own rating — tighten with a field check before launch.
    match /users/{uid} {
      allow read: if signedIn();
      allow write: if isSelf(uid);
    }

    // Sessions: readable by any signed-in user; created by any signed-in user
    // (must set themselves as organizer); only the organizer can edit/delete.
    // attendeeCount is updated by RSVP transactions, so updates are allowed for
    // signed-in users but should be locked down further before launch.
    match /sessions/{sessionId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.organizerUid == request.auth.uid;
      allow update: if signedIn();
      allow delete: if signedIn() && resource.data.organizerUid == request.auth.uid;

      // RSVPs: you can only create/edit/delete your OWN rsvp doc; anyone signed
      // in can read the roster.
      match /rsvps/{uid} {
        allow read: if signedIn();
        allow write: if isSelf(uid);
      }
    }

    // Matches are created/validated server-side (Cloud Functions) before being
    // pushed to DUPR — clients get read-only access.
    match /matches/{matchId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Shared trackers (e.g. the wedding thank-you card tracker). Open by
    // request: no sign-in, so anyone who has the app link can view/edit. Keep
    // it private by not sharing the URL. To lock it back down later, require
    // auth here (e.g. `if request.auth != null`) and restore the sign-in gate.
    match /trackers/{trackerId} {
      allow read, write: if true;
    }

    // Leaderboards — shared boards for things like the monthly Lotus
    // Challenge. Anyone can read (players get the link, no sign-in). Only the
    // academy's coach account can write: its Firebase Auth UID, or any
    // session whose *verified* email is lotuspickleballacademy@gmail.com (so
    // signing in a different way doesn't lock the academy out). Keep in sync
    // with COACH_UIDS / COACH_EMAILS in leaderboard/app.js.
    // Writes must also match the shape the app produces (below), which stops
    // a malformed or runaway document even from a coach's session. It does
    // NOT validate individual entries inside the array: the rules language
    // has no per-element loop, and entries is a plain array rather than a
    // subcollection.
    function isLeaderboardCoach() {
      return request.auth != null
        && (request.auth.uid in ['ewi5OyB2XlcJBTBRWTdqqUFOO1s2']
            || (request.auth.token.email == 'lotuspickleballacademy@gmail.com'
                && request.auth.token.email_verified == true));
    }
    function isValidLeaderboard(d) {
      return d.keys().hasOnly(['title', 'subtitle', 'entries', 'adminPinHash', 'updatedAt', 'updatedBy', 'updatedByEmail',
                               'startDate', 'endDate', 'snapshot', 'events', 'calendarId', 'calendarKey'])
        && d.title is string && d.title.size() <= 120
        && d.subtitle is string && d.subtitle.size() <= 120
        && d.entries is list && d.entries.size() <= 300
        && (d.get('adminPinHash', null) == null || (d.adminPinHash is string && d.adminPinHash.size() == 64))
        && d.updatedAt == request.time
        && d.updatedBy is string && d.updatedBy.size() <= 128
        && (d.get('updatedByEmail', null) == null || (d.updatedByEmail is string && d.updatedByEmail.size() <= 254))
        && isOptionalIsoDate(d.get('startDate', null))
        && isOptionalIsoDate(d.get('endDate', null))
        && isValidSnapshot(d.get('snapshot', null))
        && (d.get('events', null) == null || (d.get('events', null) is list && d.events.size() <= 60))
        && (d.get('calendarId', null) == null || (d.get('calendarId', null) is string && d.calendarId.size() <= 300))
        && (d.get('calendarKey', null) == null || (d.get('calendarKey', null) is string && d.calendarKey.size() <= 100));
    }
    // "YYYY-MM-DD" or absent/null — the challenge dates behind the countdown.
    function isOptionalIsoDate(v) {
      return v == null || (v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }
    // Weekly rank snapshot for the movement arrows: { at: "YYYY-MM-DD",
    // ranks: { playerId: rank } }, capped like the entries array.
    function isValidSnapshot(v) {
      return v == null
        || (v is map
            && v.keys().hasOnly(['at', 'ranks'])
            && v.at is string && v.at.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && v.ranks is map && v.ranks.size() <= 300);
    }
    match /leaderboards/{boardId} {
      allow read: if true;
      allow create, update: if isLeaderboardCoach() && isValidLeaderboard(request.resource.data);
      allow delete: if false;
    }

    // TapMenu — multi-tenant QR menu / link pages for local businesses.
    // Anyone (a customer scanning the QR) can READ a menu; only the signed-in
    // owner can create and edit their own. The doc id is the public slug used
    // in the QR URL (/menu/?m=<slug>).
    match /menus/{slug} {
      allow read: if true;
      // On create, the caller must stamp themselves as the owner.
      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid;
      // Only the current owner may edit or delete, and they cannot hand the
      // doc to someone else (ownerUid stays pinned to them).
      allow update: if signedIn()
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn()
                    && resource.data.ownerUid == request.auth.uid;
    }
  }
}
